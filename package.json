{
  "name": "pammy-panel",
  "private": true,
  "version": "0.1.0",
  "description": "Control panel for pammy.org (Pamela + momolig): a React front end and a Fastify API, in packages/ (each with its src/, web/ and widgets/), put together by sites/pammy.",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sites/pammy/web && tsc --noEmit -p sites/pammy/widgets && tsc --noEmit -p sites/lfdln/web",
    "components:build": "for c in login forms comments; do PAMMY_COMPONENT=$c vite build --config sites/pammy/widgets/vite.config.ts; done",
    "test": "node --test test/*.test.ts",
    "web:build": "vite build --config sites/pammy/web/vite.config.ts",
    "web:dev": "vite --config sites/pammy/web/vite.config.ts",
    "e2e": "playwright test -c test/e2e/playwright.config.ts",
    "e2e:lfdln": "playwright test -c test/e2e-lfdln/playwright.config.ts",
    "web:build:lfdln": "vite build --config sites/lfdln/web/vite.config.ts",
    "web:dev:lfdln": "vite --config sites/lfdln/web/vite.config.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.2",
    "fastify": "5.12.5",
    "htmlparser2": "12.0.0",
    "mysql2": "3.24.4",
    "postgres": "3.4.9",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "1.63.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.1",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.1.1",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "get-nonce": "1.0.1",
    "lit": "3.3.3",
    "lucide-react": "1.46.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
