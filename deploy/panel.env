# /etc/pammy-panel/panel.env -- read by pammy-panel.service (EnvironmentFile=)
# and by the pammy-panel command line, so both use the same database.
# No secrets here: the database password is a file only root can read
# (/etc/pammy-panel/db/panel.pass), handed to the service by systemd's
# LoadCredential= and to the command line on an open file descriptor.
PANEL_ORIGIN=https://panel.pammy.org
PANEL_RP_ID=panel.pammy.org
# the panel's own Postgres (docs/postgres-plan.md): pammy-pg, database pammy,
# schemas panel (accounts, passkeys, sessions) and media (a record per file)
PANEL_PG_HOST=127.0.0.1
PANEL_PG_PORT=5434
PANEL_PG_DATABASE=pammy
PANEL_HOST=127.0.0.1
PANEL_PORT=3044
PANEL_SITEFS_SOCKET=/run/pammy-sitefs.sock
PANEL_GATE_SOCKET=/run/pammy-gate-admin.sock
# thumbnails (docs/media-plan.md D18-D19): made by pammy-thumbs, kept by the panel
PANEL_THUMBS_SOCKET=/run/pammy-thumbs.sock
# the software helper (docs/apps-plan.md): WordPress, as the panel's "Installed software"
PANEL_APPS_SOCKET=/run/pammy-apps.sock
# the mail service (docs/apps-plan.md phase 3): the panel's notices, through Resend
PANEL_MAIL_SOCKET=/run/pammy-mail.sock
PANEL_THUMBS_DIR=/var/lib/pammy-media-public/thumbs
# the media API's index, read by the gate (docs/media-api-plan.md M2); thumbnails beside it
PANEL_MEDIA_PUBLIC=/var/lib/pammy-media-public
NODE_ENV=production
