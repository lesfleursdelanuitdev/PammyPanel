# pammy.org panel: thumbnail service (docs/media-plan.md D18-D19). Makes small
# pictures of media files for the panel: images with sharp, video frames and
# cover art with ffmpeg, PDF pages with pdftoppm. Started on demand by
# pammy-thumbs.socket.
#
# Decoding files that strangers may have made is the riskiest thing the panel
# does, so this gets its own cage: its own user, the www-data group only while
# running (to READ her website, as nginx does), nothing writable but a private
# /tmp, no network at all, no capabilities, and a memory cap. Each tool it runs
# also gets its own limits (address space, CPU seconds, open files) and is
# killed after 10 seconds. It hands the picture back over the socket; the panel
# keeps it. Installed by ~/pamela-setup/panel/deploy/install-panel.sh
[Unit]
Description=pammy.org panel: thumbnail service
Requires=pammy-thumbs.socket
After=pammy-thumbs.socket
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=svc-pammythumbs
Group=svc-pammythumbs
SupplementaryGroups=www-data
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/pammy-panel/src/thumbs/main.ts
Environment=THUMBS_PUBLIC=/pamela/public
UMask=0077
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# www-data can read these; thumbnails have no business with them
InaccessiblePaths=-/pamela/app -/pamela/trash -/srv -/var/www -/var/lib -/etc/ssl/private -/etc/ssl/cloudflare -/etc/letsencrypt -/etc/pammy-panel -/etc/nginx -/run/user
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @debug
MemoryMax=512M
MemorySwapMax=0
TasksMax=32

[Install]
WantedBy=multi-user.target
