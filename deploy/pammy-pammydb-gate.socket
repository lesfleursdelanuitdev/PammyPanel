# The database helper's second door: the gate's (S2, docs/s2-plan.md). Behind it a helper
# of its own (pammy-pammydb-gate.service) answers row ops only -- list, get, insert, update,
# delete -- for the data API, forms and comments; never databases, schemas, logins or
# passwords. Only the gate's user may open it: not the panel (its door is
# pammy-pammydb.socket), not pamela, not the web server. (root always can.)
# Installed by ~/pamela-setup/panel/deploy/install-panel.sh
[Unit]
Description=pammy.org panel: database helper socket for the gate (row ops only)

[Socket]
ListenStream=/run/pammy-pammydb-gate.sock
SocketUser=root
SocketGroup=svc-pammygate
SocketMode=0660
Accept=no
Service=pammy-pammydb-gate.service

[Install]
WantedBy=sockets.target
