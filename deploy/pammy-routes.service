# pammy.org panel: the routing helper (docs/hosts-plan.md H7; docs/phase8-plan.md 8-7). The only thing that
# writes pammy.org's hosts nginx files (/etc/nginx/pammy-hosts). Started on demand by
# pammy-routes.socket; the panel sends the whole table of hosts and routes, this
# renders every file, writes what changed, has nginx test it, puts everything
# back if nginx says no, and reloads nginx if it says yes.
# Installed by pammy.org's installer (deploy/install-panel.sh). No DNS zone is read here
# (pammy.org's DNS is kept by hand at Cloudflare, with a * record).
#
# Root, because nginx's files are root's -- and nothing more:
#   - no capabilities at all: root owns the folder it writes, so it needs none
#   - writable: /etc/nginx/pammy-hosts, and sites-enabled -- where it takes out, or puts back,
#     only the pamela site's link, at the switch (8-7c) (the files
#     themselves, in sites-available, it can't change)
#   - no network: it talks to systemd over the system bus's socket, and that is all
#   - it can't see the certificates' keys or the DreamHost key (/etc/letsencrypt):
#     `nginx -t`, the reload, the zone's listing (dreamhost-dns.sh list) and the hosts'
#     read-only checks (packages/hosts/src/probe.ts: DNS, the certificate nginx gives,
#     the answer; docs/domains-hosts-plan.md step 3) each run as a named root unit of
#     their own, which it asks systemd for (@panel/core/runner: "pammy-routes-<what>-...").
# Plainly: a root process that may ask systemd for units can have anything done.
# The boundary is the socket (only the panel's user) and the five operations,
# none of which takes a path or a command; every name in the table is checked
# again before it reaches a file (packages/hosts/src/names.ts, render.ts).
[Unit]
Description=pammy.org panel: routing helper (pammy.org's hosts in nginx)
Requires=pammy-routes.socket
After=pammy-routes.socket
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/pammy-panel/sites/pammy/src/helpers/routes.ts
UMask=0022
Restart=on-failure
RestartSec=2

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/nginx/pammy-hosts /etc/nginx/sites-enabled
InaccessiblePaths=-/etc/letsencrypt -/etc/ssl/private -/etc/ssl/cloudflare -/pamela -/srv -/var/www -/etc/pammy-panel -/etc/lfdln-panel -/run/user
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @debug
MemoryMax=256M
MemorySwapMax=0
TasksMax=32

[Install]
WantedBy=multi-user.target
