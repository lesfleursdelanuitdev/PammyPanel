# The software helper's door (docs/apps-plan.md G2). Only the panel's own user
# may open it: not pamela, not momolig, not the gate, not the web server.
# (root always can.) Installed by ~/pamela-setup/panel/deploy/install-panel.sh
[Unit]
Description=pammy.org panel: software helper socket

[Socket]
ListenStream=/run/pammy-apps.sock
SocketUser=root
SocketGroup=svc-pammypanel
SocketMode=0660
Accept=no

[Install]
WantedBy=sockets.target
