# lesfleursdelanuit.com: PHP pages in site folders (platform plan F5), as pammy.org's
# pammy-php.service and sharing nothing with it. The routing helper's nginx files send a
# *.php request in a folder with "Run PHP pages" on to /run/lfdln-php/fpm.sock.
# Installed by ~/pamela-setup/panel/deploy/lfdln/install-lfdln.sh
#
# PHP in a site folder is the least trusted code on the server, so its cage is as tight
# as pammy.org's: its own user, the lfdln-sites group only while running (to READ the
# site folders, as nginx does), nothing writable but a private /tmp, no network at all,
# no capabilities, no other programs. Of /var/www only the site folders are there,
# read-only (their .trash is 700, not its). No gate yet (phase 8): no socket to talk to.
[Unit]
Description=lesfleursdelanuit.com: PHP pages in site folders
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=svc-lfdlnphp
Group=svc-lfdlnphp
SupplementaryGroups=lfdln-sites
ExecStart=/usr/sbin/php-fpm8.3 --nodaemonize --fpm-config /etc/lfdln-php/php-fpm.conf -c /etc/lfdln-php/php.ini
ExecReload=/bin/kill -USR2 $MAINPID
RuntimeDirectory=lfdln-php
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# of /var/www, only the site folders, read-only
TemporaryFileSystem=/var/www:ro
BindReadOnlyPaths=/var/www/lesfleursdelanuit-sub
TemporaryFileSystem=/var/lib:ro
InaccessiblePaths=-/pamela -/srv -/var/log -/opt -/etc/ssl/private -/etc/ssl/cloudflare -/etc/letsencrypt -/etc/pammy-panel -/etc/lfdln-panel -/etc/nginx -/etc/php/8.3/fpm/pool.d
# every socket on the machine that anyone may open, bar the journal and systemd's notify
InaccessiblePaths=-/run/user -/run/postgresql -/run/mysqld -/run/dbus -/run/snapd.socket -/run/snapd-snap.socket -/run/uuidd -/run/systemd/resolve -/run/systemd/userdb -/run/systemd/io.systemd.ManagedOOM -/run/podman -/run/containers -/run/pammy-php -/run/pammy-gate-php.sock
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @debug
# ...except fchown: PHP-FPM gives its socket to the lfdln-sites group (listen.group), so
# nginx (in that group) may knock; without capabilities only to a group it is in
SystemCallFilter=@chown
MemoryMax=512M
MemorySwapMax=0
TasksMax=32

[Install]
WantedBy=multi-user.target
