# lesfleursdelanuit.com panel: the database helper for the gate (S2, docs/s2-plan.md), as
# pammy.org's pammy-pammydb-gate.service. The same code, user, passwords and sandbox as
# lfdln-pammydb.service (read that one's notes); started on demand by
# lfdln-pammydb-gate.socket, which only the gate's user may open, and it answers row ops only
# (packages/studio/src/pammydb/service.ts GATE_OPS). Installed by
# ~/pamela-setup/panel/deploy/lfdln/install-lfdln.sh
[Unit]
Description=lesfleursdelanuit.com panel: database helper for the gate (row ops only)
Requires=lfdln-pammydb-gate.socket
After=lfdln-pammydb-gate.socket
# a helper that can't start gives up after 5 tries instead of looping forever
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=svc-lfdlnstudio
Group=svc-lfdlnstudio
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/lfdln-panel/sites/lfdln/src/helpers/pammydb-gate.ts
WorkingDirectory=/opt/lfdln-panel
# the studio passwords, read by systemd as root and handed over in
# $CREDENTIALS_DIRECTORY: this user may not read /etc/lfdln-panel itself
LoadCredential=studio-postgres.pass:/etc/lfdln-panel/db/studio-postgres.pass
LoadCredential=studio-mariadb.pass:/etc/lfdln-panel/db/studio-mariadb.pass
UMask=0077
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# It has no business with her files, her site, the panel's own secrets or any
# other service's data. (Not all of /etc/ssl: node reads /etc/ssl/openssl.cnf at
# startup and exits without it.)
InaccessiblePaths=-/pamela -/srv -/var/lib -/var/www -/etc/nginx -/etc/pammy-panel -/etc/lfdln-panel -/etc/lfdln-mail -/etc/pammy-mail -/etc/ssl/private -/etc/ssl/cloudflare -/etc/letsencrypt -/run/user
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# the socket, and TCP to lfdln-appdb on loopback -- nothing else
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @debug
MemoryMax=512M
MemorySwapMax=0
TasksMax=32

[Install]
WantedBy=multi-user.target
