# /etc/lfdln-panel/panel.env -- read by lfdln-panel.service (EnvironmentFile=) and by
# the lfdln-panel command line, so both use the same database.
# No secrets here: the database password is a file only root can read
# (/etc/lfdln-panel/db/panel.pass), handed to the service by systemd's
# LoadCredential= and to the command line on an open file descriptor.
PANEL_ORIGIN=https://panel.lesfleursdelanuit.com
PANEL_RP_ID=panel.lesfleursdelanuit.com
# its own Postgres (docs/lfdln-standup-plan.md Q2): lfdln-pg, database lfdln
PANEL_PG_HOST=127.0.0.1
PANEL_PG_PORT=5435
PANEL_PG_DATABASE=lfdln
PANEL_HOST=127.0.0.1
PANEL_PORT=3046
# the app's door (docs/catalog-plan.md step 5): services push their things and tag them here,
# signed with their own keys; on 127.0.0.1 only, and nginx never sends anything to it
PANEL_DOOR_PORT=3048
# the folder helper (site folders) and the routing helper (hosts and routes in nginx)
PANEL_SITEFS_SOCKET=/run/lfdln-sitefs.sock
PANEL_ROUTES_SOCKET=/run/lfdln-routes.sock
PANEL_SERVICES_SOCKET=/run/lfdln-services.sock
# the projects helper (docs/phase8b-plan.md)
PANEL_PROJECTS_SOCKET=/run/lfdln-projects.sock
PANEL_MAIL_SOCKET=/run/lfdln-mail.sock
# the thumbnail service, and where the pictures go (docs/phase8-plan.md step 8-1); the
# media API's index goes beside them in /var/lib/lfdln-media-public (step 8-3)
PANEL_THUMBS_SOCKET=/run/lfdln-thumbs.sock
PANEL_THUMBS_DIR=/var/lib/lfdln-media-public/thumbs
# the media API's index.db, beside the thumbnails, for the gate (step 8-3)
PANEL_MEDIA_PUBLIC=/var/lib/lfdln-media-public
# the Studio's helper: lfdln-appdb, the apps' databases read-only (step 8-4)
PANEL_PAMMYDB_SOCKET=/run/lfdln-pammydb.sock
# its gate's admin door (docs/accounts-plan.md step 3)
PANEL_GATE_SOCKET=/run/lfdln-gate-admin.sock
# the monitoring round writes when it last ran here; lfdln-watchdog.timer reads it
PANEL_MONITOR_BEAT=/var/lib/svc-lfdlnpanel/monitor-round.json
NODE_ENV=production
