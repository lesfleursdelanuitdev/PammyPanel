# pammy.org control panel -- https://panel.pammy.org
# Installed by ~/pamela-setup/panel/deploy/install-panel.sh
#
# It needs only its own database (Postgres on 127.0.0.1:5434), a localhost port,
# and two sockets -- the
# website folder helper (/run/pammy-sitefs.sock) and the gate's admin socket
# (/run/pammy-gate-admin.sock) -- so it gets nothing else: no root, no
# network beyond localhost, no view of /home or /pamela. Changes to her files go
# through pammy-sitefs.service, which has its own, tighter sandbox.
[Unit]
Description=pammy.org control panel (panel.pammy.org)
After=network.target pammy-sitefs.socket pammy-gate-admin.socket
Wants=pammy-sitefs.socket pammy-gate-admin.socket

[Service]
Type=simple
User=svc-pammypanel
Group=svc-pammypanel
EnvironmentFile=/etc/pammy-panel/panel.env
# the database password, read by systemd as root and put where only this service
# can see it ($CREDENTIALS_DIRECTORY/db.pass): the service's user may not read
# /etc/pammy-panel/db/panel.pass itself
LoadCredential=db.pass:/etc/pammy-panel/db/panel.pass
# nginx's edge secret (docs/s1-plan.md S1c): X-Real-IP is believed only with it
LoadCredential=edge.secret:/etc/pammy-panel/edge.secret
WorkingDirectory=/opt/pammy-panel
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/pammy-panel/src/server.ts
Restart=on-failure
RestartSec=2
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
# its own state, and what it publishes for the gate's media API (docs/media-api-plan.md M2);
# the accounts and media records themselves are in Postgres now, not in a file here
# and the tutorial examples' copies, which PHP reads (docs/tutorial-examples-plan.md)
ReadWritePaths=/var/lib/svc-pammypanel /var/lib/pammy-media-public -/var/lib/pammy-tutorial-examples
ProtectHome=yes
InaccessiblePaths=-/pamela -/srv -/etc/ssl/cloudflare -/etc/letsencrypt
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# It never connects out; only nginx on this machine talks to it.
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=512M

[Install]
WantedBy=multi-user.target
