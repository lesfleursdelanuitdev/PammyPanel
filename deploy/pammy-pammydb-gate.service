# pammy.org panel: the database helper for the gate (S2, docs/s2-plan.md). The same code,
# user, passwords and sandbox as pammy-pammydb.service (read that one's notes); started on
# demand by pammy-pammydb-gate.socket, which only the gate's user may open, and it answers
# row ops only (packages/studio/src/pammydb/service.ts GATE_OPS). A process of its own, not
# a second socket on the first: the panel's helper and its unit stay exactly as they were,
# so the release before this one runs unchanged beside it. Installed by
# ~/pamela-setup/panel/deploy/install-panel.sh
[Unit]
Description=pammy.org panel: database helper for the gate (row ops only)
Requires=pammy-pammydb-gate.socket
After=pammy-pammydb-gate.socket
# a helper that can't start gives up after 5 tries instead of looping forever
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=svc-pammystudio
Group=svc-pammystudio
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/pammy-panel/src/pammydb/main-gate.ts
# the two studio passwords, read by systemd as root and handed over in
# $CREDENTIALS_DIRECTORY: this user may not read /etc/pammy-panel itself
LoadCredential=studio-postgres.pass:/etc/pammy-panel/db/studio-postgres.pass
LoadCredential=studio-mariadb.pass:/etc/pammy-panel/db/studio-mariadb.pass
UMask=0077
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# It has no business with her files, her site, the panel's own secrets or any
# other service's data. (Not all of /etc/ssl: node reads /etc/ssl/openssl.cnf at
# startup and exits without it.)
InaccessiblePaths=-/pamela -/srv -/var/lib -/var/www -/etc/nginx -/etc/pammy-panel -/etc/ssl/private -/etc/ssl/cloudflare -/etc/letsencrypt -/run/user
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# the socket, and TCP to her two engines on loopback -- nothing else
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @debug
MemoryMax=512M
MemorySwapMax=0
TasksMax=32

[Install]
WantedBy=multi-user.target
