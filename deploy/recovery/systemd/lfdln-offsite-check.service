[Unit]
Description=Off-server copy: read part of the data back and restore the newest dumps (R1)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# each target in turn; the restore test runs even if a check failed
ExecStart=-/usr/local/sbin/lfdln-offsite check 5%
ExecStart=/usr/local/sbin/lfdln-offsite restore-test
# the whole folder: restic-password and <target>/s3-* arrive as offsite_restic-password,
# offsite_<target>_s3-access-key-id ...; a target without its files is simply not there
LoadCredential=offsite:/etc/lfdln-offsite/credentials
ProtectSystem=strict
ReadWritePaths=/var/lib/lfdln-offsite /run/lock
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
Nice=10
IOSchedulingClass=idle
MemoryMax=1G
TimeoutStartSec=6h
