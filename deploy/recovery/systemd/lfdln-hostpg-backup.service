[Unit]
Description=Dump the server's own Postgres (:5432) to this disk (docs/recovery-plan.md R1; needs no target)
After=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lfdln-offsite dump-host-pg
ProtectSystem=strict
ReadWritePaths=/var/lib/lfdln-offsite /run/lock
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
# become postgres (setpriv, no PAM) and talk to it over its socket
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
Nice=10
IOSchedulingClass=idle
MemoryMax=1G
TimeoutStartSec=2h
