{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "paths": { "@panel/core/profile": ["../../../packages/core/src/profile.ts"], "@panel/lfdln/profile": ["../src/profile.ts"], "@panel/*": ["../../../packages/*"] },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "../../../packages/*/web"]
}
